# ========================================
# SERVER CONFIGURATION (REQUIRED)
# ========================================
PORT=3000
NODE_ENV=production

# ========================================
# ROBOFLOW CONFIGURATION (REQUIRED)
# ========================================
# Get API key from: https://roboflow.com
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow workspace name
ROBOFLOW_WORKSPACE_NAME=ifechukwu-nwokedi-s-workspace

# Roboflow workflow IDs (get from your workspace)
OCR_WORKFLOW_ID=pharma-ocr-identifier-1778509000939
SIFT_WORKFLOW_ID=pharma-sift-authenticity-verifier-1778509003924

# ========================================
# SUPABASE STORAGE (REQUIRED for production)
# ========================================
# Get credentials from: https://supabase.com
# Must have a bucket named 'reference-images'
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# LOCAL REFERENCE IMAGES (OPTIONAL fallback)
# ========================================
# Used if Supabase images are not found
REFERENCE_IMAGES_PATH=src/assets/reference-images
REFERENCE_INDEX_FILE=index.json

# ========================================
# LOGGING (OPTIONAL)
# ========================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# ========================================
# FRONTEND CONFIGURATION (OPTIONAL)
# ========================================
# Frontend URL for CORS (leave * for development, restrict for production)
CORS_ORIGIN=*
